generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANT / USUÁRIOS
// ============================================================

model Empresa {
  id               String            @id @default(uuid()) @db.Uuid
  nome             String
  cnpj             String?           @unique
  plano            PlanoSistema?
  statusAssinatura StatusAssinatura  @default(pendente) @map("status_assinatura")
  formaPagamento   FormaPagamento?   @map("forma_pagamento")
  diaVencimento    Int?              @map("dia_vencimento")
  cpfCnpjBoleto    String?           @map("cpf_cnpj_boleto")
  mpAssinaturaId   String?           @map("mp_assinatura_id")
  // Só usado quando plano = personalizado — preço negociado fora da tabela padrão.
  valorPersonalizado Decimal?        @db.Decimal(10, 2) @map("valor_personalizado")
  // Caminho público da logo enviada pela empresa (ex.: /uploads/logos/<uuid>.png).
  logoUrl          String?           @map("logo_url")
  // Assinatura desenhada na tela (PNG em data URL) que sai impressa nos recibos.
  assinaturaRecibo String?           @map("assinatura_recibo")
  assinanteNome    String?           @map("assinante_nome")

  // Endereço — coletado no cadastro, exigido pelo Mercado Pago para emitir
  // boleto registrado (mesmo quem paga de cartão já deixa isso resolvido).
  enderecoCep          String? @map("endereco_cep")
  enderecoLogradouro   String? @map("endereco_logradouro")
  enderecoNumero       String? @map("endereco_numero")
  enderecoComplemento  String? @map("endereco_complemento")
  enderecoBairro       String? @map("endereco_bairro")
  enderecoCidade       String? @map("endereco_cidade")
  enderecoUf           String? @map("endereco_uf")

  criadoEm         DateTime          @default(now()) @map("criado_em")

  usuarios         Usuario[]
  clientes         Cliente[]
  itensAtendimento ItemAtendimento[]
  ordensServico    OrdemServico[]
  pecas            Peca[]
  cobrancas        CobrancaPlano[]
  materiaisChapa   MaterialChapa[]
  perfisCalha      PerfilCalha[]
  orcamentosCalha  OrcamentoCalha[]
  categoriasContaPagar CategoriaContaPagar[]
  contasPagar      ContaPagar[]
  notasEntrada     NotaEntrada[]
  produtosFornecedor ProdutoFornecedor[]

  @@map("empresas")
}

enum PapelUsuario {
  desenvolvedor
  admin
  colaborador

  @@map("papel_usuario")
}

enum PlanoSistema {
  basico
  intermediario
  avancado
  personalizado

  @@map("plano_sistema")
}

enum StatusAssinatura {
  pendente
  ativo
  inadimplente
  cancelado

  @@map("status_assinatura")
}

enum FormaPagamento {
  cartao
  boleto

  @@map("forma_pagamento")
}

model CobrancaPlano {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  valor         Decimal  @db.Decimal(10, 2)
  vencimento    DateTime @db.Date
  status        String   @default("pendente") // pendente | pago | vencido
  mpPagamentoId String?  @map("mp_pagamento_id")
  linkPagamento String?  @map("link_pagamento")
  criadoEm      DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("cobrancas_plano")
}

enum ModuloSistema {
  dashboard
  ordens_servico
  orcamentos
  clientes
  estoque
  usuarios
  financeiro
  orcamento_calhas

  @@map("modulo_sistema")
}

// Identidade única de login. Uma Conta pode estar vinculada a várias
// empresas (uma linha de Usuario por empresa), sem duplicar senha/e-mail.
model Conta {
  id                       String    @id @default(uuid())
  email                    String    @unique
  senhaHash                String    @map("senha_hash")
  emailVerificado          Boolean   @default(false) @map("email_verificado")
  tokenVerificacao         String?   @map("token_verificacao")
  tokenVerificacaoExpiraEm DateTime? @map("token_verificacao_expira_em")
  criadoEm                 DateTime  @default(now()) @map("criado_em")

  usuarios Usuario[]

  @@map("contas")
}

model Usuario {
  id        String       @id @default(uuid()) @db.Uuid
  contaId   String       @map("conta_id")
  empresaId String       @map("empresa_id") @db.Uuid
  nome      String
  papel     PapelUsuario
  ativo     Boolean      @default(true)
  // Usado como valor padrão ao incluir esse usuário na mão de obra de um
  // orçamento de calhas — pode ser sobrescrito por orçamento.
  valorHora Decimal?     @map("valor_hora") @db.Decimal(10, 2)
  criadoEm  DateTime     @default(now()) @map("criado_em")

  conta   Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  osComoAtendente      OrdemServico[]        @relation("OsAtendente")
  osComoTecnico        OrdemServico[]        @relation("OsTecnico")
  diagnosticos         Diagnostico[]
  apontamentosHoras    ApontamentoHoras[]
  qaRevisoes           QaRevisao[]
  entregas             Entrega[]
  statusHistorico      OsStatusHistorico[]
  movimentacoesEstoque MovimentacaoEstoque[]
  permissoes           PermissaoUsuario[]
  maoDeObraCalha       OrcamentoCalhaMaoDeObra[]

  @@unique([contaId, empresaId])
  @@map("usuarios")
}

model PermissaoUsuario {
  id           String        @id @default(uuid())
  usuarioId    String        @map("usuario_id")
  modulo       ModuloSistema
  podeVer      Boolean       @default(false) @map("pode_ver")
  podeCriar    Boolean       @default(false) @map("pode_criar")
  podeEditar   Boolean       @default(false) @map("pode_editar")
  podeApagar   Boolean       @default(false) @map("pode_apagar")
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @default(now()) @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, modulo])
  @@map("permissoes_usuario")
}

// ============================================================
// CLIENTES E ITENS ATENDIDOS
// ============================================================

model Cliente {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  nome      String
  documento String?
  telefone  String?
  email     String?
  endereco  Json?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  itensAtendimento ItemAtendimento[]
  ordensServico    OrdemServico[]
  orcamentosCalha  OrcamentoCalha[]

  @@index([empresaId])
  @@map("clientes")
}

model ItemAtendimento {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  clienteId     String   @map("cliente_id") @db.Uuid
  tipo          String
  descricao     String
  identificador String?
  criadoEm      DateTime @default(now()) @map("criado_em")

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente       Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordensServico OrdemServico[]

  @@index([clienteId])
  @@map("itens_atendimento")
}

// ============================================================
// ORDEM DE SERVIÇO (núcleo do sistema)
// ============================================================

enum StatusOs {
  aberta
  em_diagnostico
  aguardando_aprovacao
  aprovada
  em_execucao
  em_qa
  concluida
  faturada
  entregue
  cancelada
  aguardando_peca
  reaberta

  @@map("status_os")
}

enum PrioridadeOs {
  baixa
  normal
  alta
  urgente

  @@map("prioridade_os")
}

model OrdemServico {
  id               String       @id @default(uuid()) @db.Uuid
  empresaId        String       @map("empresa_id") @db.Uuid
  numero           Int          @default(autoincrement())
  clienteId        String       @map("cliente_id") @db.Uuid
  itemId           String?      @map("item_id") @db.Uuid
  atendenteId      String?      @map("atendente_id") @db.Uuid
  tecnicoId        String?      @map("tecnico_id") @db.Uuid
  status           StatusOs     @default(aberta)
  prioridade       PrioridadeOs @default(normal)
  problemaRelatado String       @map("problema_relatado")
  osOrigemId       String?      @map("os_origem_id") @db.Uuid
  criadoEm         DateTime     @default(now()) @map("criado_em")
  atualizadoEm     DateTime     @default(now()) @updatedAt @map("atualizado_em")

  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente   Cliente          @relation(fields: [clienteId], references: [id])
  item      ItemAtendimento? @relation(fields: [itemId], references: [id])
  atendente Usuario?         @relation("OsAtendente", fields: [atendenteId], references: [id])
  tecnico   Usuario?         @relation("OsTecnico", fields: [tecnicoId], references: [id])
  osOrigem  OrdemServico?    @relation("OsRetorno", fields: [osOrigemId], references: [id])
  retornos  OrdemServico[]   @relation("OsRetorno")

  statusHistorico   OsStatusHistorico[]
  diagnosticos      Diagnostico[]
  orcamentos        Orcamento[]
  orcamentosCalha   OrcamentoCalha[]
  pecasUtilizadas   OsPecaUtilizada[]
  apontamentosHoras ApontamentoHoras[]
  qaRevisoes        QaRevisao[]
  faturas           Fatura[]
  entregas          Entrega[]
  garantias         Garantia[]
  fotos             FotoOs[]

  @@index([empresaId, status])
  @@index([clienteId])
  @@map("ordens_servico")
}

model FotoOs {
  id        String   @id @default(uuid())
  osId      String   @map("os_id")
  url       String
  legenda   String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  @@index([osId])
  @@map("fotos_os")
}

model OsStatusHistorico {
  id             String    @id @default(uuid()) @db.Uuid
  osId           String    @map("os_id") @db.Uuid
  statusAnterior StatusOs? @map("status_anterior")
  statusNovo     StatusOs  @map("status_novo")
  usuarioId      String?   @map("usuario_id") @db.Uuid
  observacao     String?
  criadoEm       DateTime  @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([osId])
  @@map("os_status_historico")
}

// ============================================================
// DIAGNÓSTICO
// ============================================================

model Diagnostico {
  id        String   @id @default(uuid()) @db.Uuid
  osId      String   @map("os_id") @db.Uuid
  tecnicoId String   @map("tecnico_id") @db.Uuid
  laudo     String
  criadoEm  DateTime @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  tecnico      Usuario      @relation(fields: [tecnicoId], references: [id])

  @@map("diagnosticos")
}

// ============================================================
// ESTOQUE DE PEÇAS
// ============================================================

model Peca {
  id                String  @id @default(uuid()) @db.Uuid
  empresaId         String  @map("empresa_id") @db.Uuid
  sku               String
  nome              String
  quantidadeEstoque Decimal @default(0) @map("quantidade_estoque") @db.Decimal(10, 2)
  valorUnitario     Decimal @default(0) @map("valor_unitario") @db.Decimal(12, 2)
  // Unidade de controle do estoque (UN, CX, KG, M...).
  unidade           String  @default("UN")
  // Último custo por unidade de estoque, atualizado no lançamento de NF-e.
  precoCusto        Decimal @default(0) @map("preco_custo") @db.Decimal(12, 4)
  ativo             Boolean @default(true)

  empresa        Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  orcamentoItens OrcamentoItem[]
  osPecas        OsPecaUtilizada[]
  movimentacoes  MovimentacaoEstoque[]
  notaItens      NotaEntradaItem[]
  produtosFornecedor ProdutoFornecedor[]

  @@unique([empresaId, sku])
  @@map("pecas")
}

enum TipoMovimentacaoEstoque {
  entrada
  saida

  @@map("tipo_movimentacao_estoque")
}

model MovimentacaoEstoque {
  id         String                  @id @default(uuid())
  pecaId     String                  @map("peca_id")
  usuarioId  String                  @map("usuario_id")
  tipo       TipoMovimentacaoEstoque
  quantidade Decimal                 @db.Decimal(10, 2)
  motivo     String?
  criadoEm   DateTime                @default(now()) @map("criado_em")

  peca    Peca    @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([pecaId])
  @@map("movimentacoes_estoque")
}

// ============================================================
// ORÇAMENTO
// ============================================================

enum StatusOrcamento {
  pendente
  aprovado
  recusado
  expirado

  @@map("status_orcamento")
}

model Orcamento {
  id           String          @id @default(uuid()) @db.Uuid
  osId         String          @map("os_id") @db.Uuid
  status       StatusOrcamento @default(pendente)
  valorTotal   Decimal         @default(0) @map("valor_total") @db.Decimal(12, 2)
  enviadoEm    DateTime?       @map("enviado_em")
  respondidoEm DateTime?       @map("respondido_em")
  validadeDias Int             @default(7) @map("validade_dias")
  criadoEm     DateTime        @default(now()) @map("criado_em")

  ordemServico OrdemServico    @relation(fields: [osId], references: [id], onDelete: Cascade)
  itens        OrcamentoItem[]

  @@map("orcamentos")
}

enum TipoItemOrcamento {
  peca
  mao_de_obra
  servico_terceiro

  @@map("tipo_item_orcamento")
}

model OrcamentoItem {
  id            String            @id @default(uuid()) @db.Uuid
  orcamentoId   String            @map("orcamento_id") @db.Uuid
  tipo          TipoItemOrcamento
  descricao     String
  quantidade    Decimal           @default(1) @db.Decimal(10, 2)
  valorUnitario Decimal           @map("valor_unitario") @db.Decimal(12, 2)
  pecaId        String?           @map("peca_id") @db.Uuid

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  peca      Peca?     @relation(fields: [pecaId], references: [id])

  @@map("orcamento_itens")
}

model OsPecaUtilizada {
  id            String   @id @default(uuid()) @db.Uuid
  osId          String   @map("os_id") @db.Uuid
  pecaId        String   @map("peca_id") @db.Uuid
  quantidade    Decimal  @db.Decimal(10, 2)
  valorUnitario Decimal  @map("valor_unitario") @db.Decimal(12, 2)
  criadoEm      DateTime @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  peca         Peca         @relation(fields: [pecaId], references: [id])

  @@map("os_pecas_utilizadas")
}

// ============================================================
// EXECUÇÃO — APONTAMENTO DE HORAS
// ============================================================

model ApontamentoHoras {
  id        String    @id @default(uuid()) @db.Uuid
  osId      String    @map("os_id") @db.Uuid
  tecnicoId String    @map("tecnico_id") @db.Uuid
  inicio    DateTime
  fim       DateTime?
  descricao String?
  criadoEm  DateTime  @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  tecnico      Usuario      @relation(fields: [tecnicoId], references: [id])

  @@map("apontamentos_horas")
}

// ============================================================
// QA / CONTROLE DE QUALIDADE
// ============================================================

enum ResultadoQa {
  aprovado
  reprovado

  @@map("resultado_qa")
}

model QaRevisao {
  id           String      @id @default(uuid()) @db.Uuid
  osId         String      @map("os_id") @db.Uuid
  supervisorId String      @map("supervisor_id") @db.Uuid
  resultado    ResultadoQa
  observacao   String?
  criadoEm     DateTime    @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  supervisor   Usuario      @relation(fields: [supervisorId], references: [id])

  @@map("qa_revisoes")
}

// ============================================================
// FATURAMENTO
// ============================================================

enum StatusPagamento {
  pendente
  parcial
  pago
  cancelado

  @@map("status_pagamento")
}

model Fatura {
  id         String          @id @default(uuid()) @db.Uuid
  osId       String          @map("os_id") @db.Uuid
  numero     Int             @default(autoincrement())
  valorTotal Decimal         @map("valor_total") @db.Decimal(12, 2)
  status     StatusPagamento @default(pendente)
  emitidaEm  DateTime        @default(now()) @map("emitida_em")

  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  pagamentos   Pagamento[]

  @@map("faturas")
}

enum StatusParcela {
  pendente
  pago
  cancelado

  @@map("status_parcela")
}

model Pagamento {
  id         String        @id @default(uuid()) @db.Uuid
  faturaId   String        @map("fatura_id") @db.Uuid
  valor      Decimal       @db.Decimal(12, 2)
  metodo     String
  status     StatusParcela @default(pago)
  vencimento DateTime?     @map("vencimento") @db.Date
  pagoEm     DateTime?     @map("pago_em")
  criadoEm   DateTime      @default(now()) @map("criado_em")

  fatura Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)

  @@map("pagamentos")
}

// ============================================================
// ENTREGA E GARANTIA
// ============================================================

model Entrega {
  id                   String   @id @default(uuid()) @db.Uuid
  osId                 String   @map("os_id") @db.Uuid
  entreguePor          String?  @map("entregue_por") @db.Uuid
  confirmadoPorCliente Boolean  @default(false) @map("confirmado_por_cliente")
  entregueEm           DateTime @default(now()) @map("entregue_em")

  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  entregador   Usuario?     @relation(fields: [entreguePor], references: [id])

  @@map("entregas")
}

model Garantia {
  id       String   @id @default(uuid()) @db.Uuid
  osId     String   @map("os_id") @db.Uuid
  prazoFim DateTime @map("prazo_fim") @db.Date
  termos   String?
  criadoEm DateTime @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  @@map("garantias")
}

// ============================================================
// ORÇAMENTO DE CALHAS (calheiros — chapas, perfis e cálculo de
// corte/mão de obra). Módulo independente do Orçamento genérico
// ligado à OS; usa a mesma permissão de módulo "orcamentos".
// ============================================================

enum TipoServicoCalha {
  calha
  algerosa
  capeamento
  rufo
  pingadeira
  tubulacao
  colarinho
  exaustor_eolico
  adicional
  venda

  @@map("tipo_servico_calha")
}

enum TipoMedidaOrcamento {
  metro
  unidade

  @@map("tipo_medida_orcamento")
}

enum StatusOrcamentoCalha {
  rascunho
  enviado
  aprovado
  recusado

  @@map("status_orcamento_calha")
}

model MaterialChapa {
  id          String   @id @default(uuid())
  empresaId   String   @map("empresa_id")
  nome        String
  espessuraMm Decimal? @map("espessura_mm") @db.Decimal(6, 2)
  tipo        String? // ex: Galvalume, Galvanizado, Alumínio, Inox
  cor         String?
  precoM2     Decimal  @default(0) @map("preco_m2") @db.Decimal(10, 2)
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")

  empresa Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  itens   OrcamentoCalhaItem[]

  @@map("materiais_chapa")
}

// Perfil de corte transversal (formato da calha). padrao=true são os
// modelos de fábrica oferecidos a toda empresa (empresaId nulo);
// cada empresa também pode salvar os próprios ("Modelos").
model PerfilCalha {
  id        String   @id @default(uuid())
  empresaId String?  @map("empresa_id")
  nome      String
  descricao String?
  segmentos Json // [{ nome: "Aba esq.", valorCm: 1.3 }, ...]
  padrao    Boolean  @default(false)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa?             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  itens   OrcamentoCalhaItem[]

  @@map("perfis_calha")
}

model OrcamentoCalha {
  id                  String               @id @default(uuid())
  empresaId           String               @map("empresa_id")
  numero              Int                  @default(autoincrement())
  clienteId           String?              @map("cliente_id")
  osId                String?              @map("os_id")
  status              StatusOrcamentoCalha @default(rascunho)
  acrescimoPercentual Decimal              @default(30) @map("acrescimo_percentual") @db.Decimal(6, 2)
  custoTotal          Decimal              @default(0) @map("custo_total") @db.Decimal(12, 2)
  precoTotal          Decimal              @default(0) @map("preco_total") @db.Decimal(12, 2)
  criadoEm            DateTime             @default(now()) @map("criado_em")
  atualizadoEm        DateTime             @default(now()) @updatedAt @map("atualizado_em")

  empresa   Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente   Cliente?                  @relation(fields: [clienteId], references: [id])
  os        OrdemServico?             @relation(fields: [osId], references: [id], onDelete: SetNull)
  itens     OrcamentoCalhaItem[]
  maoDeObra OrcamentoCalhaMaoDeObra[]

  @@index([osId])
  @@map("orcamentos_calha")
}

model OrcamentoCalhaItem {
  id                String              @id @default(uuid())
  orcamentoId       String              @map("orcamento_id")
  tipoServico       TipoServicoCalha    @map("tipo_servico")
  descricao         String? // usado quando tipoServico = adicional/venda
  tipoMedida        TipoMedidaOrcamento @default(metro) @map("tipo_medida")
  quantidade        Decimal             @default(0) @db.Decimal(10, 2)
  unidadeQuantidade String              @default("m") @map("unidade_quantidade")
  corteLargura      Decimal?            @map("corte_largura") @db.Decimal(10, 2)
  unidadeCorte      String?             @map("unidade_corte")
  materialId        String?             @map("material_id")
  perfilId          String?             @map("perfil_id")
  segmentosCustom   Json?               @map("segmentos_custom")
  valorUnitario     Decimal?            @map("valor_unitario") @db.Decimal(10, 2) // venda/adicional
  acrescimoPercentual Decimal           @default(30) @map("acrescimo_percentual") @db.Decimal(6, 2)
  custoCalculado    Decimal             @default(0) @map("custo_calculado") @db.Decimal(12, 2)
  precoCalculado    Decimal             @default(0) @map("preco_calculado") @db.Decimal(12, 2)
  criadoEm          DateTime            @default(now()) @map("criado_em")

  orcamento OrcamentoCalha @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  material  MaterialChapa? @relation(fields: [materialId], references: [id])
  perfil    PerfilCalha?   @relation(fields: [perfilId], references: [id])

  @@map("orcamento_calha_itens")
}

model OrcamentoCalhaMaoDeObra {
  id          String   @id @default(uuid())
  orcamentoId String   @map("orcamento_id")
  usuarioId   String   @map("usuario_id")
  valorHora   Decimal  @map("valor_hora") @db.Decimal(10, 2)
  horas       Decimal  @default(1) @db.Decimal(6, 2)
  custoTotal  Decimal  @default(0) @map("custo_total") @db.Decimal(12, 2)
  criadoEm    DateTime @default(now()) @map("criado_em")

  orcamento OrcamentoCalha @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])

  @@map("orcamento_calha_mao_de_obra")
}

// ============================================================
// Contas a pagar
// ============================================================

model CategoriaContaPagar {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  nome      String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contas  ContaPagar[]

  @@map("categorias_conta_pagar")
}

// Status é derivado: pagoEm preenchido = paga; senão vencimento < hoje = vencida; senão em aberto.
model ContaPagar {
  id                  String    @id @default(uuid())
  empresaId           String    @map("empresa_id")
  categoriaId         String?   @map("categoria_id")
  descricao           String
  fornecedorNome      String?   @map("fornecedor_nome")
  fornecedorDocumento String?   @map("fornecedor_documento")
  valor               Decimal   @db.Decimal(12, 2)
  vencimento          DateTime  @db.Date
  pagoEm              DateTime? @map("pago_em") @db.Date
  formaPagamento      String?   @map("forma_pagamento")
  observacao          String?
  // Contas criadas juntas pela recorrência compartilham o mesmo grupo.
  grupoRecorrenciaId  String?   @map("grupo_recorrencia_id")
  parcela             Int?
  totalParcelas       Int?      @map("total_parcelas")
  // Preenchido quando a conta veio das duplicatas de uma NF-e de entrada.
  notaEntradaId       String?   @map("nota_entrada_id")
  criadoEm            DateTime  @default(now()) @map("criado_em")

  empresa   Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria CategoriaContaPagar? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  notaEntrada NotaEntrada?       @relation(fields: [notaEntradaId], references: [id], onDelete: SetNull)

  @@index([empresaId, vencimento])
  @@index([grupoRecorrenciaId])
  @@map("contas_pagar")
}

// ============================================================
// NOTAS DE ENTRADA (NF-e importada por XML)
// ============================================================

model NotaEntrada {
  id             String   @id @default(uuid())
  empresaId      String   @map("empresa_id")
  usuarioId      String   @map("usuario_id")
  chaveAcesso    String   @map("chave_acesso")
  numero         String
  serie          String?
  fornecedorCnpj String   @map("fornecedor_cnpj")
  fornecedorNome String   @map("fornecedor_nome")
  dataEmissao    DateTime @map("data_emissao")
  valorProdutos  Decimal  @map("valor_produtos") @db.Decimal(12, 2)
  valorTotal     Decimal  @map("valor_total") @db.Decimal(12, 2)
  criadoEm       DateTime @default(now()) @map("criado_em")

  empresa Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  itens   NotaEntradaItem[]
  contasPagar ContaPagar[]

  @@unique([empresaId, chaveAcesso])
  @@map("notas_entrada")
}

model NotaEntradaItem {
  id                String  @id @default(uuid())
  notaId            String  @map("nota_id")
  pecaId            String  @map("peca_id")
  codigoFornecedor  String  @map("codigo_fornecedor")
  descricaoXml      String  @map("descricao_xml")
  ncm               String?
  unidadeXml        String  @map("unidade_xml")
  quantidadeXml     Decimal @map("quantidade_xml") @db.Decimal(14, 4)
  valorUnitarioXml  Decimal @map("valor_unitario_xml") @db.Decimal(14, 4)
  valorTotal        Decimal @map("valor_total") @db.Decimal(12, 2)
  valorFrete        Decimal @default(0) @map("valor_frete") @db.Decimal(12, 2)
  valorIpi          Decimal @default(0) @map("valor_ipi") @db.Decimal(12, 2)
  // Quantas unidades de estoque cabem em 1 unidade da nota (ex.: CX com 12 = 12).
  fatorConversao    Decimal @map("fator_conversao") @db.Decimal(14, 4)
  quantidadeEntrada Decimal @map("quantidade_entrada") @db.Decimal(14, 4)
  custoUnitario     Decimal @map("custo_unitario") @db.Decimal(12, 4)
  precoVenda        Decimal @map("preco_venda") @db.Decimal(12, 2)
  // A peça foi cadastrada por esta nota (ao excluir a nota, ela pode ser removida).
  pecaCriada        Boolean @default(false) @map("peca_criada")

  nota NotaEntrada @relation(fields: [notaId], references: [id], onDelete: Cascade)
  peca Peca        @relation(fields: [pecaId], references: [id])

  @@index([notaId])
  @@map("notas_entrada_itens")
}

// Lembra qual peça corresponde ao código do produto de cada fornecedor, e o
// fator de conversão usado, para pré-preencher as próximas importações.
model ProdutoFornecedor {
  id               String  @id @default(uuid())
  empresaId        String  @map("empresa_id")
  fornecedorCnpj   String  @map("fornecedor_cnpj")
  codigoFornecedor String  @map("codigo_fornecedor")
  pecaId           String  @map("peca_id")
  fatorConversao   Decimal @default(1) @map("fator_conversao") @db.Decimal(14, 4)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  peca    Peca    @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, fornecedorCnpj, codigoFornecedor])
  @@map("produtos_fornecedor")
}
